<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.ichi2.anki" />
    </queries>

    <application
        android:allowNativeHeapPointerTagging="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Mangaki"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <service
            android:name=".JobForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <!-- Read-only, non-exported share point for handing mined media to AnkiDroid. -->
        <provider
            android:name=".AnkiMediaProvider"
            android:authorities="dev.local.mangareader.ankimedia"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!--
            Rotation, fold/unfold, multi-window resizing, moving between displays and keyboard
            changes are handled in place so the WebView (and the reader page/zoom) survives.
            uiMode is deliberately not listed: a light/dark switch recreates the activity so the
            DayNight theme, and with it the page's prefers-color-scheme, follows the system.
        -->
        <activity
            android:name=".WebviewActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="Mangaki"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:theme="@style/MangakiWebTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MangatanActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
            android:exported="true"
            android:label="Mangaki"
            android:launchMode="singleTop">
            <meta-data android:name="android.app.lib_name" android:value="manatan_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

#!/bin/sh
set -eu

# cmake-rs 0.1.57 does not infer ANDROID_ABI from Cargo's target triple when
# the consuming crate supplies only CMAKE_TOOLCHAIN_FILE. Keep this Android
# build wrapper narrowly scoped to the one supported APK architecture.
case "${1-}" in
    --build|--install|--version|-E)
        exec "$(dirname "$0")/../../.toolchains/cmake/bin/cmake" "$@"
        ;;
    *)
        for argument in "$@"; do
            case "$argument" in
                *android.toolchain.cmake*)
                    exec "$(dirname "$0")/../../.toolchains/cmake/bin/cmake" "$@" \
                        -DANDROID_ABI=arm64-v8a \
                        -DANDROID_PLATFORM=android-26
                    ;;
            esac
        done
        # The project-local host toolchain intentionally has no yasm/nasm.
        # libaom's portable implementation is adequate for unit tests.
        exec "$(dirname "$0")/../../.toolchains/cmake/bin/cmake" "$@" -DAOM_TARGET_CPU=generic
        ;;
esac
